  "userNodes": {
    "malaga-gt-to-tf": {
      "name": "ground_truth to TF",
      "sourceCode": "// Republishes the ground truth (nav_msgs/Odometry) as a map -> base_link transform,\n// so the 3D panel can place all sensors in the map frame.\nimport { Input, Message } from \"./types\";\n\nexport const inputs = [\"/ground_truth\"];\nexport const output = \"/ground_truth_tf\";\n\ntype Output = Message<\"tf2_msgs/msg/TFMessage\">;\n\nexport default function script(event: Input<\"/ground_truth\">): Output {\n  const odom = event.message;\n  const p = odom.pose.pose;\n  return {\n    transforms: [\n      {\n        header: odom.header,\n        child_frame_id: odom.child_frame_id,\n        transform: {\n          translation: { x: p.position.x, y: p.position.y, z: p.position.z },\n          rotation: p.orientation,\n        },\n      },\n    ],\n  };\n}\n"
    }
  },
